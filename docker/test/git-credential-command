#!/bin/sh
set -eu

token=${CACHEW_TEST_GIT_TOKEN:-}
remote=${CACHEW_TEST_GIT_REMOTE:-}

case "$token" in
  ''|*[!A-Za-z0-9._-]*)
    echo "CACHEW_TEST_GIT_TOKEN must contain only test-safe token characters" >&2
    exit 2
    ;;
esac

IFS= read -r request
expected=$(printf '{"version":1,"remote_url":"%s"}' "$remote")
if [ "$request" != "$expected" ]; then
  echo "credential request URL did not match CACHEW_TEST_GIT_REMOTE" >&2
  exit 3
fi

printf '{"version":1,"authorization":"Bearer %s","expires_at":"2099-01-01T00:00:00Z"}\n' "$token"
